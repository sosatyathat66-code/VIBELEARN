# ==============================================================================
# Vibelearn Frontend Environment Variables
# ==============================================================================

# Clerk Authentication Publishable Key (Safe for client browser)
# Obtain from Clerk Dashboard: https://dashboard.clerk.com -> API Keys
# Development: pk_test_...
# Production:  pk_live_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Backend API Base URL
# Development: http://localhost:5000/api
# Production:  https://vibelearn-api.onrender.com/api (your Render backend URL)
VITE_API_URL=http://localhost:5000/api
