# ==============================================================================
# Vibelearn Backend Environment Variables
# ==============================================================================

# Server Runtime Configuration
PORT=5000
NODE_ENV=development # Set to 'production' on Render

# Allowed Frontend Client URL(s) for CORS
# Supports a single URL or comma-separated list of origins (no trailing slash)
# Development: http://localhost:5173
# Production:  https://your-vibelearn-frontend.vercel.app
CLIENT_URL=http://localhost:5173

# Database Connection (Supabase PostgreSQL)
# Obtain from Supabase Project Settings -> Database -> Connection String (URI)
# Use Transaction Pooler (port 6543) or Session Pooler (port 5432) for production serverless / Node
DATABASE_URL=postgresql://postgres:your_password@db.your_supabase_ref.supabase.co:5432/postgres

# Clerk Authentication Keys
# Obtain from Clerk Dashboard: https://dashboard.clerk.com -> API Keys
# Publishable key (optional on backend, used for reference / verification)
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
# Secret key (STRICTLY PRIVATE: never expose to client or commit to git)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
